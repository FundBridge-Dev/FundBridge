# This is an example .env file for the backend. Copy this file to .env and fill in the values.
# Generate random secret with: node -e "console.log(crypto.randomUUID() + crypto.randomUUID())"
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
DB_NAME=fundbridge
SESSION_SECRET=<long random string>
PORT=3000
